// Firestore Security Rules: authenticated-or-nothing.
//
// NOT DEPLOYED by the Firebase Authentication Login feature (spec decision 14).
// Deploying these rules locks out every client that does not sign in with
// Firebase Authentication: old app installs without the login screen, and the
// web app until it is updated. Deploy manually via the Firebase Console or CLI
// only after every device and the web app have been updated.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
