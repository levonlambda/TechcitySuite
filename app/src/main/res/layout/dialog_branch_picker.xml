<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- ========================================================================== -->
    <!-- START OF PART 1: DIALOG HEADER -->
    <!-- ========================================================================== -->

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Branch"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:layout_gravity="center" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose the store location for this device"
        android:textSize="14sp"
        android:textColor="@color/gray"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <!-- ========================================================================== -->
    <!-- END OF PART 1: DIALOG HEADER -->
    <!-- ========================================================================== -->


    <!-- ========================================================================== -->
    <!-- START OF PART 2: BRANCH LIST STATES -->
    <!-- ========================================================================== -->

    <!-- Progress Bar (shown while loading store locations) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:indeterminateTint="#3F51B5" />

    <!-- Status Message (empty list or load error) -->
    <TextView
        android:id="@+id/statusMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/gray"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- Branch List (radio buttons added in code) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioGroup
            android:id="@+id/branchRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </ScrollView>

    <!-- ========================================================================== -->
    <!-- END OF PART 2: BRANCH LIST STATES -->
    <!-- ========================================================================== -->


    <!-- ========================================================================== -->
    <!-- START OF PART 3: DIALOG BUTTONS -->
    <!-- ========================================================================== -->

    <LinearLayout
        android:id="@+id/buttonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="14sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#3F51B5"
            android:textColor="#3F51B5"
            app:cornerRadius="4dp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Retry"
            android:textSize="14sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#3F51B5"
            app:cornerRadius="4dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ========================================================================== -->
    <!-- END OF PART 3: DIALOG BUTTONS -->
    <!-- ========================================================================== -->

</LinearLayout>
