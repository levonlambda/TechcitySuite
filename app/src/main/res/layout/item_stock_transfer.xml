<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/light_gray"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">


    <!-- ========================================================================== -->
    <!-- START OF PART 1: CARD CONTENT -->
    <!-- ========================================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row: Date, Discrepancy Badge, Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/transferDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="October 10, 2026"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/techcity_blue" />

            <TextView
                android:id="@+id/discrepancyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discrepancies"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/badge_background"
                android:backgroundTint="@color/red"
                android:visibility="gone" />

            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/badge_background"
                android:backgroundTint="@color/techcity_blue" />

        </LinearLayout>

        <!-- Route Row -->
        <TextView
            android:id="@+id/routeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TC-Main → TC-Kapatagan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/directionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incoming"
            android:textSize="12sp"
            android:textColor="@color/cash_dark_green"
            android:layout_marginTop="2dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_gray"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Progress Rows -->
        <TextView
            android:id="@+id/phonesProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phones: 12 / 12 verified"
            android:textSize="13sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/accessoriesProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accessories: 65 / 80 received"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp" />

        <!-- Created / Received Info Row -->
        <TextView
            android:id="@+id/createdInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Created at 10:30 AM by Admin"
            android:textSize="10sp"
            android:textColor="@color/gray"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- ========================================================================== -->
    <!-- END OF PART 1: CARD CONTENT -->
    <!-- ========================================================================== -->


</com.google.android.material.card.MaterialCardView>
