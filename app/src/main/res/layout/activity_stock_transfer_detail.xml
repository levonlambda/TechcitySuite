<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".StockTransferDetailActivity">


    <!-- ========================================================================== -->
    <!-- START OF PART 1: HEADER -->
    <!-- ========================================================================== -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/techcity_blue"
        android:padding="16dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Row: Back Button, Date, Status Badge, Kebab -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go back"
                android:padding="8dp"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/dateLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="October 10, 2026"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginStart="8dp" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textSize="12sp"
                android:textColor="@color/techcity_blue"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="@drawable/badge_background"
                android:backgroundTint="@color/white" />

            <ImageButton
                android:id="@+id/kebabButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_kebab_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More actions"
                android:padding="8dp"
                android:visibility="gone"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Second Row: Route and Item Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginStart="48dp">

            <TextView
                android:id="@+id/routeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TC-Main → TC-Kapatagan"
                android:textSize="14sp"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/itemCountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 phones · 80 units"
                android:textSize="14sp"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- Third Row: Created By -->
        <TextView
            android:id="@+id/createdByLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Created by Admin at 10:30 AM"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:alpha="0.8"
            android:layout_marginTop="4dp"
            android:layout_marginStart="48dp" />

    </LinearLayout>

    <!-- ========================================================================== -->
    <!-- END OF PART 1: HEADER -->
    <!-- ========================================================================== -->


    <!-- ========================================================================== -->
    <!-- START OF PART 2: SUMMARY CARD -->
    <!-- ========================================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/summaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/techcity_blue"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECEIVING PROGRESS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/techcity_blue"
                android:letterSpacing="0.1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/light_gray"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/summaryPhonesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phones: 8 / 12 verified"
                android:textSize="13sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/summaryAccessoriesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accessories: 65 / 80 units received"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/summaryMissingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Missing: 1 phone · 5 units"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@android:color/holo_red_dark"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ========================================================================== -->
    <!-- END OF PART 2: SUMMARY CARD -->
    <!-- ========================================================================== -->


    <!-- ========================================================================== -->
    <!-- START OF PART 3: ITEM LIST -->
    <!-- ========================================================================== -->

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/techcity_blue"
        app:layout_constraintTop_toBottomOf="@id/summaryCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/summaryCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/emptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No items found"
            android:textSize="16sp"
            android:textColor="@color/gray"
            android:layout_marginTop="16dp"
            android:gravity="center" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/itemsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="160dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/summaryCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========================================================================== -->
    <!-- END OF PART 3: ITEM LIST -->
    <!-- ========================================================================== -->


    <!-- ========================================================================== -->
    <!-- START OF PART 4: SCAN / CONFIRM FAB -->
    <!-- ========================================================================== -->

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/scanFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:text="Scan"
        android:textColor="@color/white"
        android:visibility="gone"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white"
        app:backgroundTint="@color/techcity_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========================================================================== -->
    <!-- END OF PART 4: SCAN / CONFIRM FAB -->
    <!-- ========================================================================== -->


</androidx.constraintlayout.widget.ConstraintLayout>
